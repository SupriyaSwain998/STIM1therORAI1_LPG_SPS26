out_filename      = "calcium_signaling_pathway_heatmap"
)
# Create backup folder if it doesn't exist
dir.create("workspace_backups", showWarnings = FALSE)
# Save the entire Global Environment as RDS
saveRDS(
as.list(envir = .GlobalEnv),
file = file.path(
"workspace_backups",
paste0(Sys.Date(), "_calcium_analysis_session.rds")
)
)
dir.create("workspace_backups", showWarnings = FALSE)
save.image(
